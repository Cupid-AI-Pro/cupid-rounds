        android:pathData="M 72,30 A 28,28 0,1,0 72,78"
        android:strokeColor="#FF2D55"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Solid centered Heart -->
    <path
        android:pathData="
          M 54,70
          C 53,69 38,55 38,46
          C 38,40 43,36 49,36
          C 51.5,36 53,37 54,38
          C 55,37 56.5,36 59,36
          C 65,36 70,40 70,46
          C 70,55 55,69 54,70 Z"
        android:fillColor="#FF2D55"/>
</vector>
